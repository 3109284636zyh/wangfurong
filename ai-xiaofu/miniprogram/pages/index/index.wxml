<view class="home-page">
  <view class="hero-card">
    <view class="hero-top">
      <view class="hero-logo">福</view>
      <view class="hero-copy">
        <view class="hero-title">AI小福</view>
        <view class="hero-subtitle">建站接单客服助手 · AI陪伴聊天</view>
      </view>
      <view class="hero-settings" bindtap="goProfile">我的</view>
    </view>
    <view class="hero-desc">把客户咨询、产品报价和陪伴聊天分清楚，接单回复更快，小福也更好找。</view>
    <view class="stat-row">
      <view wx:for="{{quickStats}}" wx:key="label" class="stat-item">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="entry-grid">
    <view class="entry-card product-entry" bindtap="goProducts">
      <view class="entry-icon">🛍️</view>
      <view class="entry-title">产品功能详情</view>
      <view class="entry-desc">查看建站服务、套餐报价和交付说明</view>
      <view class="entry-action">进入电商</view>
    </view>
    <view class="entry-card chat-entry" bindtap="goChat">
      <view class="entry-icon">💕</view>
      <view class="entry-title">AI聊天对话</view>
      <view class="entry-desc">进入 AI小福，开始轻松聊天</view>
      <view class="entry-action">找小福聊</view>
    </view>
  </view>

  <view class="assistant-card">
    <view class="assistant-head">
      <view>
        <view class="section-title">💼 客服助手快捷入口</view>
        <view class="section-desc">粘贴闲鱼/淘宝/拼多多客户咨询，一键生成合规回复</view>
      </view>
      <view class="assistant-toggle" bindtap="toggleAssistant">{{showAssistant ? '收起' : '展开'}}</view>
    </view>

    <view class="sample-list" wx:if="{{!showAssistant}}">
      <view wx:for="{{sampleQuestions}}" wx:key="*this" class="sample-item" bindtap="useSample" data-text="{{item}}">{{item}}</view>
    </view>

    <view wx:if="{{showAssistant}}" class="assistant-panel">
      <textarea
        class="input-area"
        value="{{inputText}}"
        placeholder="在此粘贴客户咨询内容。例如：建一个企业官网多少钱？包含哪些服务？"
        bindinput="onInputChange"
        auto-height
        maxlength="5000"
      />
      <view class="input-footer">
        <text class="char-count">{{inputText.length}}/5000</text>
      </view>
      <button class="btn btn-primary" bindtap="generateReply" loading="{{generating}}" disabled="{{!inputText || generating}}">⚡ 一键生成合规回复</button>
      <view class="action-row">
        <button class="btn btn-outline btn-half" bindtap="clearAll" disabled="{{!inputText && !outputText}}">清空</button>
        <button class="btn btn-outline btn-half" bindtap="copyResult" disabled="{{!outputText}}">复制结果</button>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{outputText || generating}}">
    <view class="section-header">
      <text class="section-title">✨ AI生成回复</text>
      <text class="section-desc" wx:if="{{responseInfo}}">{{responseInfo}}</text>
    </view>
    <view class="output-area">
      <view wx:if="{{generating}}" class="loading-box">
        <view class="loading-dots">
          <view class="dot dot-1"></view>
          <view class="dot dot-2"></view>
          <view class="dot dot-3"></view>
        </view>
        <text class="loading-text">AI正在生成合规回复...</text>
      </view>
      <view wx:else class="output-content">
        <text class="output-text">{{outputText}}</text>
      </view>
    </view>
    <view wx:if="{{isViolation}}" class="violation-tip">⚠️ 回复已通过风控检测，违禁词已自动处理</view>
  </view>

  <view wx:if="{{errorMsg}}" class="error-box">
    <text>❌ {{errorMsg}}</text>
  </view>

  <view class="tips-card">
    <view class="tips-title">今天可以这样用</view>
    <view class="tip-row">1. 先到“电商”查看产品和报价口径</view>
    <view class="tip-row">2. 回到首页粘贴客户问题，生成合规回复</view>
    <view class="tip-row">3. 需要放松时，进入 AI聊天对话找小福</view>
  </view>
</view>
