page {
  background: #f4f6fb;
}

.shop-page {
  min-height: 100vh;
  padding: 16px 14px 34px;
  box-sizing: border-box;
}

.shop-hero {
  padding: 20px;
  border-radius: 24px;
  background: linear-gradient(135deg, #1d4ed8, #6366f1 56%, #8b5cf6);
  color: #fff;
  box-shadow: 0 16px 34px rgba(99,102,241,0.2);
}

.hero-label {
  display: inline-flex;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(255,255,255,0.16);
  font-size: 12px;
}

.hero-title {
  margin-top: 12px;
  font-size: 23px;
  font-weight: 800;
}

.hero-desc {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.7;
  opacity: .9;
}

.category-scroll {
  margin: 14px -14px 2px;
}

.category-list {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
  padding: 0 14px 10px;
}

.category-pill {
  display: inline-flex;
  margin-right: 9px;
  padding: 9px 14px;
  border-radius: 999px;
  background: #fff;
  color: #6b7280;
  font-size: 13px;
  box-shadow: 0 4px 14px rgba(15,23,42,0.05);
}

.category-pill.active {
  background: #6366f1;
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8px 18px rgba(99,102,241,0.22);
}

.state-card {
  margin-top: 14px;
  padding: 28px 18px;
  border-radius: 20px;
  background: #fff;
  color: #6b7280;
  text-align: center;
  font-size: 14px;
  box-shadow: 0 8px 24px rgba(15,23,42,0.06);
}

.state-card.error {
  color: #dc2626;
  background: #fff7f7;
}

.empty-icon {
  font-size: 32px;
}

.empty-title {
  margin-top: 8px;
  font-size: 16px;
  font-weight: 700;
  color: #1f2937;
}

.empty-desc {
  margin-top: 6px;
  font-size: 12px;
  color: #9ca3af;
  line-height: 1.6;
}

.loading-dot-row {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-bottom: 12px;
}

.loading-dot-row text {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #6366f1;
  animation: pulse .7s infinite alternate;
}

.loading-dot-row text:nth-child(2) {
  animation-delay: .15s;
}

.loading-dot-row text:nth-child(3) {
  animation-delay: .3s;
}

@keyframes pulse {
  to {
    opacity: .3;
    transform: translateY(-4px);
  }
}

.small-btn {
  margin-top: 14px;
  width: 118px;
  height: 36px;
  line-height: 36px;
  border-radius: 999px;
  background: #6366f1;
  color: #fff;
  font-size: 13px;
}

.small-btn::after {
  border: none;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 10px;
}

.product-card {
  padding: 16px;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(15,23,42,0.06);
}

.product-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.product-name {
  font-size: 17px;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.4;
}

.product-category {
  display: inline-flex;
  margin-top: 6px;
  padding: 3px 8px;
  border-radius: 999px;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 11px;
}

.product-price {
  flex-shrink: 0;
  color: #ef4444;
  font-size: 16px;
  font-weight: 800;
}

.product-summary {
  margin-top: 12px;
  color: #6b7280;
  font-size: 13px;
  line-height: 1.7;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.meta-item {
  padding: 6px 9px;
  border-radius: 10px;
  background: #f8fafc;
  color: #6b7280;
  font-size: 12px;
}

.card-actions,
.detail-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.action-btn {
  flex: 1;
  height: 40px;
  line-height: 40px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 700;
  margin: 0;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.ghost {
  background: #f8fafc;
  color: #4b5563;
}

.action-btn.primary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(15,23,42,0.48);
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  width: 100%;
  max-height: 82vh;
  padding: 18px 16px calc(18px + env(safe-area-inset-bottom));
  border-radius: 24px 24px 0 0;
  background: #fff;
  box-sizing: border-box;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.detail-title {
  font-size: 18px;
  font-weight: 800;
  color: #1f2937;
}

.detail-category {
  margin-top: 5px;
  color: #6b7280;
  font-size: 12px;
}

.detail-close {
  width: 32px;
  height: 32px;
  line-height: 30px;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  text-align: center;
  font-size: 24px;
}

.detail-scroll {
  max-height: 56vh;
  margin-top: 12px;
}

.detail-block {
  padding: 13px 0;
  border-bottom: 1px solid #f1f5f9;
}

.block-title {
  color: #1f2937;
  font-size: 14px;
  font-weight: 800;
  margin-bottom: 7px;
}

.block-text {
  color: #6b7280;
  font-size: 13px;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
