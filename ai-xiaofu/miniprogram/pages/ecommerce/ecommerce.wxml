<view class="shop-page">
  <view class="shop-hero">
    <view class="hero-label">建站服务电商</view>
    <view class="hero-title">产品、套餐和报价口径</view>
    <view class="hero-desc">从后台产品库读取已启用服务，先看清交付范围，再生成客户回复。</view>
  </view>

  <view class="category-scroll">
    <scroll-view scroll-x class="category-list">
      <view wx:for="{{categories}}" wx:key="*this" class="category-pill {{activeCategory === item ? 'active' : ''}}" bindtap="selectCategory" data-category="{{item}}">{{item}}</view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <view class="loading-dot-row"><text></text><text></text><text></text></view>
    <view>正在加载产品库...</view>
  </view>

  <view wx:elif="{{errorMsg}}" class="state-card error">
    <view>{{errorMsg}}</view>
    <button class="small-btn" bindtap="fetchProducts">重新加载</button>
  </view>

  <view wx:elif="{{displayProducts.length === 0}}" class="state-card empty">
    <view class="empty-icon">📦</view>
    <view class="empty-title">暂无上架产品</view>
    <view class="empty-desc">可在后台产品库添加并启用产品后，这里会自动展示。</view>
  </view>

  <view wx:else class="product-list">
    <view wx:for="{{displayProducts}}" wx:key="id" class="product-card">
      <view class="product-top">
        <view>
          <view class="product-name">{{item.name}}</view>
          <view class="product-category">{{item.categoryName}}</view>
        </view>
        <view class="product-price">{{item.priceText}}</view>
      </view>
      <view class="product-summary">{{item.summary}}</view>
      <view class="meta-row">
        <view class="meta-item">⏱ {{item.deliveryDays}}</view>
        <view class="meta-item">🛡 {{item.afterSales}}</view>
      </view>
      <view class="card-actions">
        <button class="action-btn ghost" bindtap="showProductDetail" data-id="{{item.id}}">查看详情</button>
        <button class="action-btn primary" bindtap="generateReplyForProduct" data-id="{{item.id}}">生成回复</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showDetail && currentProduct}}" class="detail-mask" bindtap="closeDetail">
    <view class="detail-panel" catchtap="noop">
      <view class="detail-head">
        <view>
          <view class="detail-title">{{currentProduct.name}}</view>
          <view class="detail-category">{{currentProduct.categoryName}} · {{currentProduct.priceText}}</view>
        </view>
        <view class="detail-close" bindtap="closeDetail">×</view>
      </view>
      <scroll-view scroll-y class="detail-scroll">
        <view class="detail-block">
          <view class="block-title">服务介绍</view>
          <view class="block-text">{{currentProduct.description}}</view>
        </view>
        <view class="detail-block">
          <view class="block-title">包含服务</view>
          <view class="block-text">{{currentProduct.includedServices}}</view>
        </view>
        <view class="detail-block">
          <view class="block-title">不包含服务</view>
          <view class="block-text">{{currentProduct.excludedServices}}</view>
        </view>
        <view class="detail-block">
          <view class="block-title">交付与售后</view>
          <view class="block-text">交付周期：{{currentProduct.deliveryDays}}</view>
          <view class="block-text">售后保障：{{currentProduct.afterSales}}</view>
        </view>
      </scroll-view>
      <view class="detail-actions">
        <button class="action-btn ghost" bindtap="copyProductInfo">复制信息</button>
        <button class="action-btn primary" bindtap="generateReplyForProduct">生成回复</button>
      </view>
    </view>
  </view>
</view>
