page {
  background: #f4f6fb;
}

.profile-page {
  min-height: 100vh;
  padding: 16px 14px 34px;
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  border-radius: 24px;
  background: linear-gradient(135deg, #6366f1, #8b5cf6 58%, #ec4899);
  color: #fff;
  box-shadow: 0 16px 34px rgba(99,102,241,0.22);
}

.avatar {
  width: 58px;
  height: 58px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.18);
  border: 1px solid rgba(255,255,255,0.28);
  font-size: 24px;
  font-weight: 800;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-title {
  font-size: 23px;
  font-weight: 800;
}

.profile-desc {
  margin-top: 5px;
  font-size: 13px;
  opacity: .88;
}

.status-grid {
  display: flex;
  gap: 12px;
  margin-top: 14px;
}

.status-card {
  flex: 1;
  padding: 14px 12px;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(15,23,42,0.06);
  text-align: center;
}

.status-value {
  color: #1f2937;
  font-size: 16px;
  font-weight: 800;
}

.status-label {
  margin-top: 5px;
  color: #9ca3af;
  font-size: 12px;
}

.menu-section {
  margin-top: 14px;
  padding: 16px;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(15,23,42,0.06);
}

.section-title {
  margin-bottom: 10px;
  color: #1f2937;
  font-size: 16px;
  font-weight: 800;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-top: 1px solid #f1f5f9;
}

.menu-item:first-of-type {
  border-top: none;
}

.menu-icon {
  width: 38px;
  height: 38px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19px;
}

.menu-icon.purple { background: #eef2ff; }
.menu-icon.blue { background: #eff6ff; }
.menu-icon.green { background: #f0fdf4; }
.menu-icon.pink { background: #fdf2f8; }
.menu-icon.orange { background: #fff7ed; }
.menu-icon.red { background: #fef2f2; }
.menu-icon.gray { background: #f3f4f6; }

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #1f2937;
  font-size: 15px;
  font-weight: 700;
}

.menu-desc {
  margin-top: 4px;
  color: #9ca3af;
  font-size: 12px;
  line-height: 1.45;
}

.menu-arrow {
  color: #c0c4cc;
  font-size: 25px;
}

.footer-note {
  padding: 18px 0 4px;
  color: #b0b7c3;
  font-size: 11px;
  text-align: center;
}
